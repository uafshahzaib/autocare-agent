# Set ONE of the two providers below. Anthropic is used automatically if
# ANTHROPIC_API_KEY is set (leave LLM_PROVIDER unset), or force a choice
# explicitly with LLM_PROVIDER=anthropic / LLM_PROVIDER=openai.

# Anthropic (Claude) — get a key at https://console.anthropic.com
# Note: this is separate from a claude.ai Pro subscription; Pro does not
# include API credits, you need a console.anthropic.com account with billing set up.
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI — get a key at https://platform.openai.com
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

LLM_PROVIDER=
